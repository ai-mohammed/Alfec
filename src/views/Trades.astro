---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { approach } from '../data/company';
import { trades } from '../data/trades';
import { photos } from '../data/photos';
import { tradePath } from '../i18n/routes.mjs';
import { tx, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  title: { fr: 'Nos métiers · ALFEC Oran', en: 'Our trades · ALFEC Oran' },
  description: {
    fr: 'Les six métiers d’ALFEC : génie climatique, protection et détection incendie, désenfumage, électricité et régulation, froid industriel, génie industriel.',
    en: 'ALFEC’s six trades: HVAC, fire protection and detection, smoke control, electrical and controls, industrial refrigeration, industrial engineering.',
  },
  h1: { fr: 'Nos six métiers', en: 'Our six trades' },
  origin: { fr: 'Notre métier d’origine', en: 'Our founding trade' },
};
const arrow = '<path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" />';
---

<Base lang={lang} title={tx(copy.title, lang)} description={tx(copy.description, lang)} current="trades">
  <PageHead
    lang={lang}
    title={tx(copy.h1, lang)}
    lead={tx({ fr: approach.fr[1], en: approach.en[1] }, lang)}
    image={photos.couloirClimatise.src}
  />

  <section class="section" aria-label={tx(copy.h1, lang)}>
    <div class="wrap">
      <ol class="hub" role="list">
        {
          trades.map((t, i) => (
            <li class="trade grid" data-reveal>
              <a class="t-photo" href={tradePath(t.key, lang)} tabindex="-1" aria-hidden="true">
                <Photo photo={photos[t.cover]} lang={lang} caption={false} ratio="4 / 3" sizes="(min-width: 1024px) 40vw, 100vw" priority={i === 0} />
              </a>
              <div class="t-text">
                <span class="no tnum" aria-hidden="true">{t.number}</span>
                {i === 0 && <span class="flag">{tx(copy.origin, lang)}</span>}
                <h2 class="t-name">
                  <a href={tradePath(t.key, lang)}>{tx(t.name, lang)}</a>
                </h2>
                <p class="t-sum">{tx(t.summary, lang)}</p>
                <ul class="t-scope" role="list">
                  {tx(t.scope, lang).map((s) => <li>{s}</li>)}
                </ul>
                <a class="link-arrow" href={tradePath(t.key, lang)} aria-label={`${tx(ui.cta.tradeMore, lang)} : ${tx(t.name, lang)}`}>
                  <span>{tx(ui.cta.tradeMore, lang)}</span>
                  <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={arrow} />
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <EnquiryBand lang={lang} />
</Base>

<style>
  .hub {
    list-style: none;
    border-top: 1px solid var(--edge);
  }

  .trade {
    align-items: center;
    row-gap: var(--s-5);
    padding-block: clamp(36px, 4.5vw, 64px);
    border-bottom: 1px solid var(--edge);
  }

  .t-photo {
    grid-column: 1 / span 5;
    display: block;
    overflow: hidden;
  }

  .t-photo :global(img) {
    transition: transform 1s var(--ease-out);
  }

  .trade:hover .t-photo :global(img) {
    transform: scale(1.04);
  }

  .t-text {
    grid-column: 7 / span 6;
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .no {
    font-family: var(--cond);
    font-size: clamp(3.5rem, 2.5rem + 2.4vw, 5.5rem);
    font-weight: 800;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--sky);
  }

  .flag {
    padding: 7px 10px;
    background: var(--accent);
    color: var(--night);
    font-family: var(--cond);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .t-name {
    font-size: clamp(2.4rem, 1.6rem + 2vw, 3.75rem);
  }

  .t-name a {
    text-decoration: none;
  }

  .t-name a:hover {
    color: var(--accent);
  }

  .t-sum {
    max-width: 52ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--fg-2);
  }

  .t-scope {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .t-scope li {
    padding: 8px 10px;
    border: 1px solid var(--line-strong);
    font-family: var(--cond);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 1023px) {
    .t-photo {
      grid-column: 1 / span 5;
    }

    .t-text {
      grid-column: 6 / -1;
    }
  }

  @media (max-width: 767px) {
    .t-photo,
    .t-text {
      grid-column: 1 / -1;
    }
  }
</style>
