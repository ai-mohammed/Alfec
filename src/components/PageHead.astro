---
// Shared head for interior pages: breadcrumb trail, title, optional lead, optional photograph behind.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { pagePath } from '../i18n/routes.mjs';
import { tx, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  /** Intermediate crumbs between Home and the current page. */
  trail?: { label: string; href: string }[];
  /** Short label shown above the title, e.g. a trade number. */
  number?: string;
  /** Short name for the breadcrumb when the title is a sentence. */
  crumb?: string;
  /** Photograph shown behind the head, darkened for legibility. */
  image?: ImageMetadata;
  /** Focal point of the photograph, e.g. "50% 40%". */
  position?: string;
}

const { lang, title, lead, trail = [], number, crumb, image, position = '50% 50%' } = Astro.props;
const widths = image ? [...new Set([640, 960, 1280, 1520].filter((w) => w < image.width).concat(image.width))] : [];
---

<header class:list={['page-head', { 'has-image': image }]}>
  {
    image && (
      <div class="bg" aria-hidden="true" style={`--pos:${position}`}>
        <Picture src={image} formats={['avif', 'webp']} fallbackFormat="jpg" widths={widths} sizes="100vw" alt="" loading="eager" fetchpriority="high" />
      </div>
    )
  }
  <div class="wrap inner">
    <nav class="crumbs" aria-label={lang === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}>
      <ol role="list">
        <li><a href={pagePath('home', lang)}>{tx(ui.nav.home, lang)}</a></li>
        {trail.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        <li aria-current="page">{crumb ?? title}</li>
      </ol>
    </nav>
    {number && <p class="kicker num tnum">{number}</p>}
    <h1 class="title">{title}</h1>
    {lead && <p class="lead intro">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: calc(var(--header-h) + clamp(32px, 5vw, 80px)) clamp(56px, 7vw, 112px);
    border-bottom: 1px solid var(--line);
  }

  .page-head.has-image {
    min-height: min(78vh, 720px);
    display: grid;
    align-items: end;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .bg :global(picture),
  .bg :global(img) {
    width: 100%;
    height: 100%;
  }

  .bg :global(img) {
    object-fit: cover;
    object-position: var(--pos);
  }

  .has-image::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(5 22 41 / 0.92) 0%, rgb(5 22 41 / 0.66) 50%, rgb(5 22 41 / 0.3) 100%),
      linear-gradient(0deg, rgb(5 22 41 / 0.96) 0%, rgb(5 22 41 / 0) 55%);
  }

  .inner {
    display: grid;
    justify-items: start;
    gap: clamp(20px, 2.4vw, 28px);
  }

  .crumbs {
    margin-bottom: clamp(8px, 2vw, 24px);
    font-size: var(--fs-meta);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    color: var(--text-2);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: var(--s-2);
    color: var(--sky);
  }

  .crumbs a {
    color: var(--white);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .title {
    max-width: 16ch;
  }

  .intro {
    max-width: 58ch;
    color: #d2deea;
  }

  @media (max-width: 767px) {
    .page-head.has-image {
      min-height: 0;
    }
  }
</style>
