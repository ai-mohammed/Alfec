---
// Algeria outline (Natural Earth 1:50m via world-atlas, public domain) with the 22 wilayas
// published on alfec.net's "Nos implantations" map. Rendered to static SVG at build time.
import { feature } from 'topojson-client';
import type { Topology, GeometryCollection } from 'topojson-specification';
import world from 'world-atlas/countries-50m.json';
import { wilayas } from '../data/company';
import { tx, type Bilingual, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Show the list of wilaya names under the map. */
  names?: boolean;
  /** 'locator' draws only the outline and the head office (contact page). */
  variant?: 'full' | 'locator';
  /** Draw the network: a line from the Oran head office to each wilaya, traced when scrolled into view. */
  lines?: boolean;
}

const { lang, names = true, variant = 'full', lines = false } = Astro.props;

const topo = world as unknown as Topology<{ countries: GeometryCollection }>;
const countries = feature(topo, topo.objects.countries);
const algeria = countries.features.find((f) => f.id === '012');
if (!algeria || algeria.geometry.type !== 'Polygon') throw new Error('Algeria outline not found in world-atlas');
const ring = algeria.geometry.coordinates[0] as [number, number][];

// Equirectangular projection corrected for latitude: accurate enough at this scale.
const lons = ring.map(([x]) => x);
const lats = ring.map(([, y]) => y);
const minLon = Math.min(...lons);
const maxLon = Math.max(...lons);
const minLat = Math.min(...lats);
const maxLat = Math.max(...lats);
const k = Math.cos((((minLat + maxLat) / 2) * Math.PI) / 180);
const W = 600;
const scale = W / ((maxLon - minLon) * k);
const H = Math.round((maxLat - minLat) * scale);
const project = (lon: number, lat: number) => [(lon - minLon) * k * scale, (maxLat - lat) * scale] as const;

const outline =
  ring
    .map(([lon, lat], i) => {
      const [x, y] = project(lon, lat);
      return `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
    })
    .join('') + 'Z';

const points = wilayas
  .map((w) => {
    const [x, y] = project(w.lng, w.lat);
    return { ...w, x, y, hq: w.name === 'Oran' };
  })
  .filter((p) => variant === 'full' || p.hq);

const label: Bilingual =
  variant === 'full'
    ? {
        fr: 'Carte de l’Algérie montrant les 22 wilayas d’implantation d’ALFEC, dont le siège à Oran',
        en: 'Map of Algeria showing ALFEC’s 22 wilayas, including the Oran head office',
      }
    : { fr: 'Carte de l’Algérie situant le siège d’ALFEC à Oran', en: 'Map of Algeria locating ALFEC’s head office in Oran' };
const hq = points.find((p) => p.hq);
// A gentle arc from the head office to each wilaya, bowing upward so the lines read as a network.
const linkTo = (p: { x: number; y: number }) => {
  if (!lines || !hq) return null;
  const mx = (hq.x + p.x) / 2;
  const my = Math.min(hq.y, p.y) - 30 - Math.abs(p.x - hq.x) * 0.08;
  return `M${hq.x.toFixed(1)} ${hq.y.toFixed(1)}Q${mx.toFixed(1)} ${my.toFixed(1)} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
};
// Names show above their point on hover or tap; near the edges they align inward so they stay inside the map,
// and around Oran they drop below the point so they never sit on the ORAN label.
const anchorFor = (x: number) => (x > W - 90 ? 'end' : x < 90 ? 'start' : 'middle');
const nameY = (p: { x: number; y: number }) =>
  hq && Math.abs(p.x - hq.x) < 160 && p.y < hq.y + 40 ? p.y + 32 : p.y - 16;
---

<figure class:list={['wilaya-map', { network: lines }]} data-reveal={lines ? '' : undefined}>
  <svg viewBox={`-20 -40 ${W + 40} ${H + 60}`} role="img" aria-label={tx(label, lang)}>
    <path class="land" d={outline} />
    {
      points
        .filter((p) => !p.hq)
        .map((p, i) => {
          const d = linkTo(p);
          return (
            <g
              class="pt"
              style={`--i:${i}`}
              tabindex="-1"
              data-name={p.name}
              data-x={p.x.toFixed(1)}
              data-y={nameY(p).toFixed(1)}
              data-anchor={anchorFor(p.x)}
            >
              {d && <path class="link" d={d} pathLength="1" />}
              <circle cx={p.x} cy={p.y} r="11" class="hit" />
              <circle cx={p.x} cy={p.y} r="5" class="dot" />
            </g>
          );
        })
    }
    {
      hq && (
        <g class="pt hq">
          <circle cx={hq.x} cy={hq.y} r="14" class="ring" />
          <circle cx={hq.x} cy={hq.y} r="7" class="dot" />
          <text x={hq.x + 20} y={hq.y - 18} class="hq-label">Oran</text>
        </g>
      )
    }
    {variant === 'full' && <text class="name" aria-hidden="true" data-label />}
  </svg>
  {
    names && variant === 'full' && (
      <figcaption>
        <ul class="names" role="list">
          {points.map((p) => <li class:list={{ hq: p.hq }}>{p.name}</li>)}
        </ul>
      </figcaption>
    )
  }
</figure>

<script>
  // One label drawn above every point, so a name is never hidden by its neighbours: it follows the point
  // being hovered, or focused by a tap on touch screens.
  for (const svg of document.querySelectorAll<SVGSVGElement>('.wilaya-map svg')) {
    const label = svg.querySelector<SVGTextElement>('[data-label]');
    if (!label) continue;
    const show = (target: EventTarget | null) => {
      const pt = (target as Element | null)?.closest<SVGGElement>('.pt[data-name]');
      if (!pt) return;
      label.textContent = pt.dataset.name ?? '';
      label.setAttribute('x', pt.dataset.x ?? '0');
      label.setAttribute('y', pt.dataset.y ?? '0');
      label.setAttribute('text-anchor', pt.dataset.anchor ?? 'middle');
      label.classList.add('on');
    };
    const hide = () => {
      if (!svg.querySelector('.pt:focus')) label.classList.remove('on');
    };
    svg.addEventListener('pointerover', (event) => show(event.target));
    svg.addEventListener('pointerout', hide);
    svg.addEventListener('focusin', (event) => show(event.target));
    svg.addEventListener('focusout', () => label.classList.remove('on'));
  }
</script>

<style>
  .wilaya-map {
    --land: rgb(41 168 232 / 0.06);
    --stroke: rgb(41 168 232 / 0.7);
    --pt: var(--white);
    --hq: var(--accent);
    --halo: var(--night);
    margin: 0;
  }

  :global(.light) .wilaya-map {
    --land: #e2eaf2;
    --stroke: var(--accent-dark);
    --pt: var(--ink);
    --hq: var(--accent-dark);
    --halo: var(--paper);
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .land {
    fill: var(--land);
    stroke: var(--stroke);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .link {
    fill: none;
    stroke: rgb(41 168 232 / 0.55);
    stroke-width: 1.1;
  }

  .dot {
    fill: var(--pt);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.25s var(--ease-out), fill 0.25s;
  }

  /* Hover (or tap, which focuses the point) names the wilaya and lights its line to Oran. */
  .hit {
    fill: transparent;
  }

  .pt:not(.hq) {
    outline: none;
  }

  .name {
    font-family: var(--cond);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: var(--fg);
    paint-order: stroke;
    stroke: var(--halo);
    stroke-width: 7px;
    stroke-linejoin: round;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease-out);
  }

  .name:global(.on) {
    opacity: 1;
  }

  .pt:hover .dot,
  .pt:focus .dot {
    fill: var(--hq);
    transform: scale(1.5);
  }

  .pt:hover .link,
  .pt:focus .link {
    stroke: var(--hq);
    stroke-width: 2;
  }

  .hq-label {
    transition: opacity 0.2s var(--ease-out);
  }

  svg:has(.name:global(.on)) .hq-label {
    opacity: 0.25;
  }

  .hq .dot {
    fill: var(--hq);
  }

  .ring {
    fill: none;
    stroke: var(--hq);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hq-label {
    font-family: var(--cond);
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--hq);
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    margin-top: var(--s-6);
    list-style: none;
    font-size: var(--fs-small);
    color: var(--fg-2);
  }

  .names .hq {
    font-weight: 700;
    color: var(--fg);
  }

  /* The network draws itself once, then the head office keeps pulsing. */
  @media (prefers-reduced-motion: no-preference) {
    .ring {
      animation: pulse 2.4s ease-out infinite;
    }

    .network .link {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 1.4s var(--ease-out);
      transition-delay: calc(var(--i) * 70ms + 0.2s);
    }

    /* The points pop in after their line; `backwards` fill hands the transform back to the hover style afterwards. */
    :global(.js) .network:not(:global(.in)) .pt:not(.hq) .dot {
      transform: scale(0);
    }

    .network:global(.in) .pt:not(.hq) .dot {
      animation: pop 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
      animation-delay: calc(var(--i) * 70ms + 1s);
    }

    @keyframes pop {
      from {
        transform: scale(0);
      }
      to {
        transform: scale(1);
      }
    }

    .network:global(.in) .link {
      stroke-dashoffset: 0;
    }

    @keyframes pulse {
      from {
        transform: scale(0.7);
        opacity: 1;
      }
      to {
        transform: scale(2.4);
        opacity: 0;
      }
    }
  }
</style>
